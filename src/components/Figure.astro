---
/** Frame for an interactive widget: id + title bar above, caption slot below. */
interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<figure class="widget" id={id.toLowerCase()} aria-label={`Interactive: ${title}`}>
  <div class="bar"><span class="chip live">{id}</span><span class="t">{title}</span></div>
  <slot />
</figure>
<style>
  .widget { margin: 2em 0; background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); overflow: hidden; }
  .bar { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--rule); font-family: var(--sans); font-size: 0.92rem; font-weight: 600; }
</style>
